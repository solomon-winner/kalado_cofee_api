{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "product"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "quantity": {
      "type": "biginteger",
      "required": true,
      "min": "0"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "discount": {
      "type": "decimal",
      "min": 0
    },
    "retailer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::app-user.app-user",
      "inversedBy": "products"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "product"
    },
    "isPopular": {
      "type": "boolean",
      "default": false
    },
    "properties": {
      "type": "json"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "json"
    },
    "deletedAt": {
      "type": "datetime",
      "default": null
    }
  }
}
