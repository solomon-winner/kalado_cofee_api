{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::app-user.app-user",
      "inversedBy": "orders"
    },
    "retailer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::app-user.app-user",
      "inversedBy": "retailer_orders"
    },
    "total_amount": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "required": true
    },
    "final_amount": {
      "type": "decimal"
    },
    "orderedAt": {
      "type": "datetime",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "confirmed",
        "shipped",
        "delivered",
        "cancelled"
      ]
    },
    "shippment_address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shippment-address.shippment-address"
    },
    "phoneNumber": {
      "type": "string"
    },
    "deletedAt": {
      "type": "datetime"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "paymentStatus": {
      "type": "enumeration",
      "default": "unpaid",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ]
    },
    "paymentMethod": {
      "type": "enumeration",
      "default": "unpaid",
      "enum": [
        "paypal",
        "stripe",
        "COD",
        "unpaid"
      ]
    },
    "tax_amount": {
      "type": "decimal",
      "default": 0
    },
    "shippment_method": {
      "type": "string",
      "enum": [
        "standard",
        "express",
        "next-day"
      ],
      "default": "standard"
    },
    "discount_amount": {
      "type": "decimal",
      "default": 0
    },
    "paidAt": {
      "type": "datetime"
    },
    "purchase_history": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::purchase-history.purchase-history",
      "mappedBy": "order"
    }
  }
}
