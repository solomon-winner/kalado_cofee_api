{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::app-user.app-user",
      "inversedBy": "orders"
    },
    "retailer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::app-user.app-user",
      "inversedBy": "retailer_orders"
    },
    "total_amount": {
      "type": "decimal",
      "required": true
    },
    "orderedAt": {
      "type": "datetime",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "confirmed",
        "shipped",
        "delivered",
        "cancelled"
      ]
    },
    "shippment_address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shippment-address.shippment-address"
    },
    "phoneNumber": {
      "type": "string"
    },
    "deletedAt": {
      "type": "datetime"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "paymentStatus": {
      "type": "enumeration",
      "default": "unpaid",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ]
    },
    "paymentMethod": {
      "type": "enumeration",
      "default": "online",
      "enum": [
        "online",
        "COD"
      ]
    },
    "paidAt": {
      "type": "datetime"
    }
  }
}
