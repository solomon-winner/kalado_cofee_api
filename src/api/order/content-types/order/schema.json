{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::app-user.app-user",
      "inversedBy": "orders"
    },
    "total_amount": {
      "type": "decimal",
      "required": true
    },
    "orderedAt": {
      "type": "datetime",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"],
      "default": "pending"
    },
      "shippment_address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shippment-address.shippment-address"
    },
    "phoneNumber": {
      "type": "string"
    },
    "deletedAt": {
      "type": "datetime",
      "default": null
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    
  "paymentStatus": {
    "type": "enumeration",
    "enum": ["unpaid", "paid", "refunded"],
    "default": "unpaid"
  },
  "paymentMethod": {
    "type": "enumeration",
    "enum": ["online", "COD"],
    "default": "online"
  },
  "paidAt": {
    "type": "datetime"
  }

  }
}
