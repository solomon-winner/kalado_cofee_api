{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "orders"
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::app-user.app-user",
      "inversedBy": "orders"
    },
    "total_amount": {
      "type": "decimal",
      "required": true
    },
    "orderedAt": {
      "type": "datetime",
      "required": true
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    }
  }
}
