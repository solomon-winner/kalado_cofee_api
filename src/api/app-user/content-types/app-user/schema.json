{
  "kind": "collectionType",
  "collectionName": "app_users",
  "info": {
    "singularName": "app-user",
    "pluralName": "app-users",
    "displayName": "app-user"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "password": {
      "type": "password",
      "private": true,
      "required": true,
      "minLength": 6
    },
    "type": {
      "type": "enumeration",
      "default": "customer",
      "enum": [
        "customer",
        "retailer",
        "blogger",
        "admin"
      ]
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "retailer"
    },
    "orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "customer"
    },
    "blogs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog.blog",
      "mappedBy": "writer"
    },
    "shippment_addresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::shippment-address.shippment-address",
      "mappedBy": "customer"
    },
    "deletedAt": {
      "type": "datetime"
    },
    "resetPasswordToken": {
      "type": "string"
    },
    "resetTokenExpiry": {
      "type": "datetime"
    },
    "retailer_orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "retailer"
    },
    "purchase_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::purchase-history.purchase-history",
      "mappedBy": "customer"
    }
  }
}
